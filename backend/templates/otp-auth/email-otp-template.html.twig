<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification Code</title>
    <style>
        body, table, td, p, a, li, blockquote {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table, td {
            border-collapse: collapse;
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            border: 0;
            height: auto;
            line-height: 100%;
            outline: none;
            text-decoration: none;
            -ms-interpolation-mode: bicubic;
        }

        body {
            margin: 0 !important;
            padding: 0 !important;
            font-family: 'Arial', 'Helvetica', sans-serif;
            background-color: #f5f5f5;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }

        .content {
            padding: 40px 30px;
        }

        .greeting {
            font-size: 18px;
            color: hsl(0, 0%, 5%);
            margin-bottom: 20px;
            font-weight: 600;
        }

        .otp-container {
            background-color: hsl(0, 0%, 98%);
            border: 2px solid hsl(0, 84%, 45%);
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            margin: 30px 0;
        }

        .otp-label {
            font-size: 14px;
            color: hsl(0, 0%, 45%);
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .otp-code {
            font-size: 36px;
            font-weight: bold;
            color: hsl(0, 84%, 45%);
            letter-spacing: 8px;
            font-family: 'Courier New', monospace;
            margin: 0;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        }

        .otp-note {
            font-size: 12px;
            color: hsl(0, 0%, 55%);
            margin-top: 15px;
        }

        .warning {
            background-color: #fff3cd;
            border: 1px solid #ffeaa7;
            border-radius: 6px;
            padding: 15px;
            margin: 25px 0;
            font-size: 14px;
            color: #856404;
        }

        @media (prefers-color-scheme: dark) {
            body {
                background-color: hsl(0, 0%, 10%) !important;
            }

            .email-container {
                background-color: hsl(0, 0%, 12%) !important;
            }

            .content {
                background-color: hsl(0, 0%, 12%) !important;
            }

            .greeting {
                color: hsl(0, 0%, 95%) !important;
            }

            .otp-container {
                background-color: hsl(0, 0%, 8%) !important;
                border-color: hsl(0, 84%, 55%) !important;
            }

            .otp-label {
                color: hsl(0, 0%, 60%) !important;
            }

            .event-details strong {
                color: hsl(0, 0%, 90%) !important;
            }

            .warning {
                background-color: hsl(45, 100%, 15%) !important;
                border-color: hsl(45, 100%, 30%) !important;
                color: hsl(45, 100%, 85%) !important;
            }
        }

        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
            }

            .content {
                padding-left: 20px !important;
                padding-right: 20px !important;
            }

            .otp-code {
                font-size: 28px !important;
                letter-spacing: 4px !important;
            }
        }
    </style>
</head>
<body>
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
    <tr>
        <td>
            <div class="email-container">

                <div class="content">
                    <div class="greeting">
                        Hello, {{ user_name }}!
                    </div>

                    <div class="otp-container">
                        <div class="otp-label">Your Verification Code</div>
                        <p class="otp-code">{{ code }}</p>
                        <div class="otp-note">This code expires in 20 minutes</div>
                    </div>

                    <div class="warning">
                        ⚠️ <strong>Security Notice:</strong> Never share this verification code with anyone.
                    </div>

                    <div class="message">
                        If you didn't request this verification code, please ignore this email.
                    </div>
                </div>

            </div>
        </td>
    </tr>
</table>
</body>
</html>
